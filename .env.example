# Copy to .env and adjust. Nothing here is secret in the demo deployment, but
# the file documents every knob the container reads.

# SqlServer | Sqlite
Database__Provider=Sqlite

# SQLite:     Data Source=/data/employees.db;Default Timeout=5
# SQL Server: Server=localhost,1433;Database=EmployeeDB;User Id=sa;Password=...;TrustServerCertificate=True
ConnectionStrings__DefaultConnection=Data Source=/data/employees.db;Default Timeout=5

# Where uploaded employee photos are written. Keep this on the same volume as
# the SQLite file so the two reset together on an ephemeral filesystem.
Storage__PhotosPath=/data/Photos

# Origins allowed to call the API. Indexed, one per entry.
Cors__AllowedOrigins__0=http://localhost:4200

# Injected by most container hosts. The API binds 0.0.0.0 on this port.
PORT=8080
