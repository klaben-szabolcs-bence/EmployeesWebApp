<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <VersionPrefix>0.0.1</VersionPrefix>
    <AssemblyVersion>$(VersionPrefix)</AssemblyVersion>
    <FileVersion>$(VersionPrefix)</FileVersion>
    <!-- Smaller image and faster start; no culture-sensitive formatting here. -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Newtonsoft is load-bearing: JsonResult(DataTable) does not serialise
         under System.Text.Json. Do not swap this out without replacing the
         DataTable-based responses first. -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="10.0.11" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
    <PackageReference Include="System.Data.SqlClient" Version="4.8.6" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <!-- Placeholder avatar. Must be published: the startup initializer copies it
         into the (possibly empty, possibly ephemeral) photos directory so seeded
         rows render an image rather than a broken one. -->
    <Content Include="Photos\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\schema.sqlite.sql" Link="Seed\schema.sqlite.sql" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\seed.sqlite.sql" Link="Seed\seed.sqlite.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
